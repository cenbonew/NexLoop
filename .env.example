# Documentation template. In the repository this is committed as .env.example; copy to .env (git-ignored) for local
# development, or to a PRIVATE host path for stage. Never commit real values.
# Fill with local inventory; no assumption that hosts are currently reachable.
DATA_BIND_IP=
APP_BIND_IP=
DATA_HOST=
PUBLIC_HOST=
PG_PUBLISHED_PORT=
VALKEY_PUBLISHED_PORT=
HTTPS_PORT=
HTTP_REDIRECT_PORT=
CONFIG_DIR=
SECRET_DIR=
DATA_ROOT=
# Set audited image references as name@sha256:<64 hex>; never latest.
# A registry mirror prefix (e.g. m.daocloud.io/docker.io/library/postgres@sha256:...) is allowed; digest stays the same.
POSTGRES_IMAGE=
VALKEY_IMAGE=
BACKEND_IMAGE=
AGENT_HOST_IMAGE=
WEB_IMAGE=
GATEWAY_IMAGE=
POSTGRES_DB=
# Target startup gate only; tenant permissions are separately enforced.
REAL_DISPATCH_ENABLED=
API_PROCESSES=
AGENT_CONCURRENCY=
CI_BUILD_CONCURRENCY=
AGENT_HOST_PORT=
# Model IDs/provider and embedding dimensions must be chosen and tested, not guessed.
MODEL_PROVIDER=
MODEL_ID=
MODEL_BASE_URL=
# Credentials: LOCAL DEVELOPMENT may put the key here (this file is git-ignored; .env.example is committed with blanks).
# Production/stage MUST use the mounted secret file instead; when MODEL_CREDENTIALS_FILE is set and non-empty it wins and MODEL_API_KEY is ignored.
MODEL_API_KEY=
# Embedding provider (ADR-019 recall). Names follow the owner's .env. Local dev may put the key here; stage uses EMBEDDING_CREDENTIALS_FILE (file wins when non-empty).
EMBEDDING_API_KEY=
# e.g. doubao-embedding-vision-251215
EMBEDDING_MODEL=
# text | multimodal (current owner choice: multimodal endpoint; text input path must be verified)
EMBEDDING_MODE=
# full endpoint URL, must be on the maintainer allowlist (docs/11 §8)
EMBEDDING_LOCATION=
# measured once from a real call, then frozen; index dimension never silently changes
EMBEDDING_DIMENSION=
EMBEDDING_CREDENTIALS_FILE=
# Private SECRET_DIR files (not values in this env):
# pg_bootstrap_password, api_dsn, domain_worker_dsn, action_worker_dsn,
# scheduler_dsn, valkey_credentials, valkey.acl, runtime_client_credentials,
# model_credentials, artifact_signing_key, session_signing_key.
# TLS files: db-ca.crt, postgres-server.crt/key, valkey-server.crt/key.

MODEL_CREDENTIALS_FILE=

# Private raw 32-byte Artifact authority key; never exposed to Runtime/model clients.
ARTIFACT_AUTHORITY_SIGNING_KEY_FILE=

# Private DSN file used by doctor/stage; values stay outside this repository.
DATABASE_URL_FILE=
