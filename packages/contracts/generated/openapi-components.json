        "title": "action-intent",
        "description": "NexLoop target contract; server-derived identity required. This is not an existing upstream EIOS/Pi API.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
