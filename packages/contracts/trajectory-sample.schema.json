{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:trajectory-sample",
  "title": "trajectory-sample",
  "description": "NX-038 E2 (design §11.2, D10/D11): one trajectory sample a diagnosis reads, from either route with one shape: the database route (authz.nexloop_evo_trace_runs as nexloop_evo_reader; one issued Run) or the evidence-pack route (one NX-037 interaction record). Identifiers, codes, counts and times only: never a message body, Claim value, prompt, quote or credential. `persona` is the served Consumer's ADR-034 persona (D12, always labelled; null when the Run serves no Consumer or the record carries none); test-stack records never reach a formal diagnosis (§11.3). A sample is input to diagnosis, never a business fact. NexLoop target contract; server-derived identity required. This is not an existing upstream EIOS/Pi API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "run_id",
    "interaction_id",
    "run_kind",
    "scenario",
    "issued_at",
    "consumer_id",
    "persona",
    "test_stack",
    "outcome",
    "error_code",
    "model",
    "tool_calls",
    "intents",
    "intent_ids",
    "refusals",
    "failures",
    "recovered_tool_errors",
    "receipts",
    "reconciliation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "enum": [
        "database",
        "evidence_pack"
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      ]
    },
    "interaction_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      ]
    },
    "run_kind": {
      "enum": [
        "message",
        "fallback",
        "role",
        "other",
        null
      ]
    },
    "scenario": {
      "enum": [
        "ordinary_reply",
        "real_delivery",
        "restricted_after_refusal",
        "human_takeover",
        "unknown_reconciliation",
        null
      ]
    },
    "issued_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "consumer_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "persona": {
      "enum": [
        "real",
        "simulated_agent",
        "synthetic",
        null
      ]
    },
    "test_stack": {
      "type": "boolean"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "failed",
        "unknown"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "intents": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "intent_ids": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "refusals": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]{1,64}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "failure_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "failure_detail": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "failure_tool": {
            "type": "string",
            "pattern": "^(nexloop\\.[a-z][a-z_.]{0,63}|unregistered_tool)$"
          }
        }
      }
    },
    "recovered_tool_errors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "code"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^nexloop\\.[a-z][a-z_.]{0,63}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
      }
    },
    "reconciliation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      ]
    }
  }
}
