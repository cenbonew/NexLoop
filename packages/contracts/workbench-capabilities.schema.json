{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:workbench-capabilities",
  "title": "workbench-capabilities",
  "description": "Enterprise world model W3 (owner 2026-10-19): the owner workbench's read-only capability catalog of one tenant, GET /api/v1/workbench/capabilities (workbench read verb `capabilities`). Metadata only: the governed capability registry, the tenant's business Action definitions with their effect categories (undeclared means closed, customer contact by default), inbound channel namespaces, the effect Actions active catalog offerings deliver through (counts), and the real dispatch switches from the same SQL source as the metrics read. No consumer, message, intent or credential data. NexLoop target contract; server-derived identity required. This is not an existing upstream EIOS/Pi API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "actions",
    "channels",
    "routes",
    "provider_routes",
    "real_dispatch"
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "operation",
          "subject_rule",
          "source_task",
          "registered_at"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "subject_rule": {
            "enum": [
              "human",
              "agent_or_human"
            ]
          },
          "source_task": {
            "type": "string",
            "pattern": "^NX-[0-9]{3}$"
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "stable_name",
          "version",
          "capability",
          "capability_version",
          "has_side_effects",
          "active",
          "effect_category",
          "effect_category_declared",
          "effect_manifest_version"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^eios:action:[A-Za-z0-9][A-Za-z0-9._-]{0,159}:[1-9][0-9]{0,8}$"
          },
          "stable_name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "capability": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_side_effects": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "effect_category": {
            "enum": [
              "customer_contact",
              "non_contact_service",
              null
            ]
          },
          "effect_category_declared": {
            "type": "boolean"
          },
          "effect_manifest_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "trust",
          "skew_seconds"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          },
          "trust": {
            "enum": [
              "server",
              "signed",
              "client"
            ]
          },
          "skew_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_action",
          "active_offerings"
        ],
        "properties": {
          "delivery_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "active_offerings": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "provider_routes": {
      "const": "deployment_configuration"
    },
    "real_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "tenant",
        "actions"
      ],
      "properties": {
        "world": {
          "const": "real"
        },
        "tenant": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "data_mode",
                "revision"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "data_mode": {
                  "enum": [
                    "real",
                    "test",
                    null
                  ]
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "enabled",
              "revision"
            ],
            "properties": {
              "action_type": {
                "type": "string",
                "pattern": "^eios:action:[A-Za-z][A-Za-z0-9_.]{0,159}:[1-9][0-9]{0,8}$"
              },
              "enabled": {
                "type": "boolean"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
