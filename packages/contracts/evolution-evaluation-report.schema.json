{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:evolution-evaluation-report",
  "title": "evolution-evaluation-report",
  "description": "NX-038 E5 (design §12.4, §7; D7): the evaluation report of one frozen evolution-evaluation-bundle at one level (L0 deterministic replay in NX-038; L1 belongs to NX-039). Every frozen hard gate is answered pass or fail with evidence ids, separately from the scores; `accept` requires every gate passed, and an equal score is never an acceptance (D7). Missing inputs end `incomplete`, never a pass. Ids, codes, scores and numbers only; never a message body, Claim value, prompt or patch text. The report digest goes to the candidate event log and review links (D4). A report changes no candidate status. NexLoop target contract; server-derived identity required. This is not an existing upstream EIOS/Pi API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "candidate_id",
    "bundle_digest",
    "level",
    "evaluator_version",
    "hard_gates",
    "scores",
    "swaps",
    "cost",
    "elapsed_ms",
    "conclusion",
    "reason",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "level": {
      "enum": [
        "L0",
        "L1"
      ]
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@+-]{1,128}$"
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "result",
          "evidence_ids"
        ],
        "properties": {
          "gate": {
            "enum": [
              "references_valid",
              "structure_valid",
              "zero_overreach",
              "zero_cross_tenant",
              "zero_fact_pollution",
              "no_forbidden_regression",
              "semantic_regression",
              "cost_performance",
              "semantic_conflict",
              "index_migration_impact"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            }
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "validation",
        "metrics"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "parent",
            "candidate"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "parent": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "candidate": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "parent",
            "candidate"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "parent": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "candidate": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ambiguity_rate",
            "regressions",
            "missing_cases"
          ],
          "properties": {
            "ambiguity_rate": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "regressions": {
              "type": "integer",
              "minimum": 0
            },
            "missing_cases": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "swaps": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "swapped"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "swapped": {
            "type": "boolean"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "unit"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "conclusion": {
      "enum": [
        "accept",
        "reject",
        "incomplete"
      ]
    },
    "reason": {
      "enum": [
        null,
        "hard_gate_failed",
        "not_better",
        "inferior",
        "missing_data",
        "budget_exhausted",
        "validation_leak",
        "not_reproducible",
        "breaking_change",
        "evaluator_timeout"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hard_gates_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@+-]{1,128}$",
      "description": "NX-039 V2: the frozen gate version the report answers (optional, additive)."
    },
    "failed_gates": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]{1,64}$"
      },
      "description": "NX-039 V2: the failed gates in registry order; each gate id is its own rejection code (optional, additive)."
    },
    "change_class": {
      "enum": [
        "patch",
        "minor",
        "major",
        "refused"
      ],
      "description": "NX-039 V2 (D39-7): decided by classify_change, never set by a person or an Agent; major and refused are always rejected (optional, additive)."
    },
    "reproduced": {
      "type": "boolean",
      "description": "NX-039 V2 (D39-2): the second L0 pass gave the same report (optional, additive)."
    }
  }
}
