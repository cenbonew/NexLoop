            ],
            "maxLength": 24
          },
          "gloss_source": {
            "enum": [
              "manual",
              "machine",
              null
            ]
          },
          "inverse_gloss": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 24
          },
          "inverse_gloss_source": {
            "enum": [
              "manual",
              "machine",
              null
            ]
          }
        }
      }
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "object_type",
          "description",
          "payload_property_count",
          "gloss",
          "gloss_source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,159}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "object_type": {
