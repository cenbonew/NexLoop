{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:twin-calibration-report",
  "title": "twin-calibration-report",
  "description": "NX-042 T5 (design §3.2, §3.3, D2, D3, D4, D7): the frozen calibration report of one consumer twin version. Input: real aggregate metrics only (T4: world real, real personas, groups of at least 30 Consumers; counts and rates, never a per-Consumer value), a calibration window after the version's publication, split by time from the reference window and grouped by Consumer (a Consumer of the reference window is excluded). Metrics per (behaviour, group) cell: the twin's interval, the observed rate, whether the interval covered it and the Brier score of the interval midpoint; the coverage against the nominal (80% intervals: 70%-90%, D3). Conclusion: passed, failed, insufficient_sample (fewer than 8 cells; no verdict) or not_calibratable (a behaviour without real aggregate data stays uncalibrated, D4). Only passed and failed append a calibration event; passed makes the version selectable by NX-043 (D7). Immutable once written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "twin_id", "version", "twin_digest", "world", "split", "input", "metrics", "conclusion", "reason", "requested_by", "request_id", "created_at"],
  "properties": {
    "schema": {"const": "nexloop-twin-calibration-report/1"},
    "twin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "twin_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "world": {"const": "real"},
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["split_at", "span_days", "reference", "calibration", "grouping", "reference_consumers_excluded"],
      "properties": {
        "split_at": {"type": "string"},
        "span_days": {"enum": [28, 56, 84]},
        "reference": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "calibration": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "grouping": {"const": "consumer"},
        "reference_consumers_excluded": {"type": "integer", "minimum": 0}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "min_group_consumers", "input_digest", "groups", "suppressed", "excluded"],
      "properties": {
        "source": {"const": "authz.nexloop_twin_calibration_aggregates"},
        "min_group_consumers": {"const": 30},
        "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group", "consumers"],
          "properties": {"group": {"type": "string"}, "consumers": {"type": "integer", "minimum": 30}}}},
        "suppressed": {"type": "array", "items": {"enum": ["all", "daypart"]}},
        "excluded": {"type": "object", "additionalProperties": false, "required": ["non_real_persona", "erasing", "in_reference_window"],
          "properties": {"non_real_persona": {"type": "integer", "minimum": 0}, "erasing": {"type": "integer", "minimum": 0}, "in_reference_window": {"type": "integer", "minimum": 0}}}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["cells", "cell_count", "covered_cells", "coverage", "nominal_coverage", "coverage_band", "min_cells", "brier", "uncalibrated_behaviors"],
      "properties": {
        "cells": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["behavior", "group", "consumers", "observed_rate", "low", "high", "nominal_coverage", "covered", "brier"],
          "properties": {
            "behavior": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "group": {"type": "string"},
            "consumers": {"type": "integer", "minimum": 30}, "observed_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "low": {"type": "number", "minimum": 0, "maximum": 1}, "high": {"type": "number", "minimum": 0, "maximum": 1},
            "nominal_coverage": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
            "covered": {"type": "boolean"}, "brier": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "cell_count": {"type": "integer", "minimum": 0},
        "covered_cells": {"type": "integer", "minimum": 0},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "nominal_coverage": {"type": ["number", "null"]},
        "coverage_band": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "min_cells": {"const": 8},
        "brier": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "uncalibrated_behaviors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conclusion": {"enum": ["passed", "failed", "insufficient_sample", "not_calibratable"]},
    "reason": {"type": ["string", "null"], "maxLength": 500},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "created_at": {"type": "string"}
  }
}
