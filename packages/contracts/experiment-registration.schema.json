{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:experiment-registration",
  "title": "experiment-registration",
  "description": "NX-043 X1 (design §2-§5, D2-D6, D9): the preregistration of an experiment, frozen at registration (D3): hypothesis (a hypothesis, never a fact), the candidate and control strategy versions (control null: the current policy), the twin version a screening uses (null when none), the primary metric, the guardrails, the sample sizes, the maturity window, the budget, the end time and the allocation seed. Every field is required (registration_incomplete otherwise). Guardrail and maturity members left out take the defaults of D4 and D6 (refusal or unsubscribe rate at most 2 points above control, no reconciliation anomaly, stop when the budget is exhausted; 14-day maturity window, 30 matured samples per group); a given value may only be tighter. D2: at most 20 candidate consumers and a control group at least as large. D1/D5: no incentive budget in the first batch. The stage decides the world: screening in a simulation world with a twin, shadow in a shadow world, online in real. Starting checks the registration again: a selected twin must be calibrated now (D9). No field opens real dispatch, and a registration that mentions it is refused. The frozen part is server-derived.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "stage",
    "world",
    "hypothesis",
    "candidate",
    "control",
    "twin",
    "primary_metric",
    "guardrails",
    "sample_size",
    "maturity",
    "budget",
    "ends_at",
    "allocation_seed"
  ],
  "properties": {
    "schema": {
      "const": "nexloop-experiment-registration/1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "stage": {
      "enum": [
        "screening",
        "shadow",
        "online"
      ]
    },
    "world": {
      "type": "string",
      "pattern": "^(real|sim:[0-9a-f-]{36}|shadow:[0-9a-f-]{36})$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "version"
      ],
      "properties": {
        "strategy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "control": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy_id",
            "version"
          ],
          "properties": {
            "strategy_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "twin": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "twin_id",
            "version"
          ],
          "properties": {
            "twin_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "primary_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "direction"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ]
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refusal_or_unsubscribe_rate_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.02
        },
        "reconciliation_anomalies": {
          "const": 0
        },
        "stop_on_budget_exhausted": {
          "const": true
        }
      }
    },
    "sample_size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "control"
      ],
      "properties": {
        "candidate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "control": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        }
      }
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_days": {
          "type": "integer",
          "minimum": 14,
          "maximum": 90
        },
        "min_samples_per_group": {
          "type": "integer",
          "minimum": 30,
          "maximum": 99999
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_cny",
        "incentive_cny"
      ],
      "properties": {
        "model_cny": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "incentive_cny": {
          "const": 0
        }
      }
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "allocation_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "budget_drill": {
      "const": true,
      "description": "NX-043 X7 item 10 (owner 2026-10-28): a budget drill - accepted only for a screening in a simulation world, a model cap above 0 and at most 1 CNY, an end at most one hour away and a published, uncalibrated twin; waives the twin calibration (D9) for this drill only. The result does not represent the experiment's effect."
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "description": "X4 (design §3): who may enter an online experiment, frozen with the registration. A member left out takes the default (persona real, no active contact restriction, no active takeover); none can be loosened.",
      "properties": {
        "persona": {
          "const": "real"
        },
        "exclude_contact_restricted": {
          "const": true
        },
        "exclude_in_takeover": {
          "const": true
        }
      }
    },
    "frozen": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-derived at registration, never accepted from the owner.",
      "required": [
        "registration_digest",
        "status"
      ],
      "properties": {
        "registration_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "registered",
            "started",
            "stopped"
          ]
        }
      }
    }
  }
}
