                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,200}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
