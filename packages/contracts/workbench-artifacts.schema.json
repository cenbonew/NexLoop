{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:workbench-artifacts",
  "title": "workbench-artifacts",
  "description": "Enterprise world model W4 (data assets): one page of a tenant's stored local Artifacts for the owner workbench, GET /api/v1/workbench/artifacts (workbench read verb `artifacts`; owners and operators, ADR-025 / ADR-035). Metadata only: id, purpose (from the binding that holds it), media type, size, the first 12 hex digits of its sha256, created and retention times, the source Run and the owning Consumer id; never content, storage keys or upload details. Newest first; `next_before` is the cursor '<created_at>|<artifact_id>' of the page's last item. An Artifact of a Consumer being erased, or one an erasure is deleting, is not listed and is counted in `hidden`. Each listed Artifact is audited. NexLoop target contract; server-derived identity required. This is not an existing upstream EIOS/Pi API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "total",
    "hidden",
    "next_before"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "purpose",
          "media_type",
          "size_bytes",
          "sha256_prefix",
          "created_at",
          "retention_until",
          "run_id",
          "consumer_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "purpose": {
            "enum": [
              "message_context",
              "fallback_context",
              "role_context",
              "other"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256_prefix": {
            "type": "string",
            "pattern": "^[a-f0-9]{12}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "retention_until": {
            "type": "string",
            "format": "date-time"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uuid"
              }
            ]
          },
          "consumer_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "hidden": {
      "type": "integer",
      "minimum": 0
    },
    "next_before": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9][0-9T:. +-]{9,39}\\|[a-f0-9]{32}$"
        }
      ]
    }
  }
}
