{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexloop:contracts:v1:consumer-twin",
  "title": "consumer-twin",
  "description": "NX-042 T1 (design §2, D1, D4, D5, D7): one version of a consumer twin - the explicit hypotheses, the decision-layer parameters and the generator version. Hypotheses are statements, never facts. Every behaviour parameter is an interval (D4: no single probability). A twin holds no real content (D5): parameters and hypotheses only; it is kept for good and is not deleted with a simulation world (its events in a world are, NX-041 D2). The owner publishes a version through a governed Action (D7); the server assigns the version, freezes it, records its calibration (a report reference and status) and keeps its status as appended events (published, retired). A version without a passed calibration report is 'uncalibrated' and NX-043 cannot select it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "twin_id", "hypotheses", "parameters", "generator_version"],
  "properties": {
    "schema": {"const": "nexloop-consumer-twin/1"},
    "twin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "description": {"type": "string", "maxLength": 500},
    "hypotheses": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "statement", "kind"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500},
          "kind": {"const": "hypothesis"}
        }
      }
    },
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["behaviors"],
      "properties": {
        "behaviors": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["low", "high", "coverage", "hypotheses"],
            "description": "A behaviour's probability as an interval at its nominal coverage, and the hypotheses it rests on.",
            "properties": {
              "low": {"type": "number", "minimum": 0, "maximum": 1},
              "high": {"type": "number", "minimum": 0, "maximum": 1},
              "coverage": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
              "hypotheses": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}
            }
          }
        }
      }
    },
    "generator_version": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,39}/[0-9]+$"},
    "frozen": {
      "type": "object", "additionalProperties": false,
      "description": "Server-derived at publication, never accepted from the publisher.",
      "required": ["version", "definition_digest", "calibration", "status"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "calibration": {
          "type": "object", "additionalProperties": false, "required": ["report_ref", "status"],
          "properties": {
            "report_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^twin-calibration:[0-9a-f]{64}$"}]},
            "status": {"enum": ["uncalibrated", "calibrated"]}
          }
        },
        "status": {"enum": ["published", "retired"]}
      }
    }
  }
}
