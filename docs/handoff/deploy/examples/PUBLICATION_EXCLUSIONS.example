# Incorporate into the public implementation repository .gitignore and release checks.
# .gitignore is NOT a secret scanner; previously committed data must also be removed.
local-only/
.env
.env.*
!.env.example
!env.example
secrets/
private/
*.key
*.pem
!tests/fixtures/synthetic-certificates/*.pem
runtime-data/
artifacts-private/
backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.dump
*.tar.enc
# Do not publish merged private handoff versions containing LAN inventory.
NexLoop_完整交接文档_*.md
NexLoop_完整交接文档_*.html
