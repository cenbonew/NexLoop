# Target PostgreSQL18 configuration. Tune only after inventory and measurement.
listen_addresses = '*'
port = 5432
hba_file = '/etc/postgresql/pg_hba.conf'
ssl = on
ssl_cert_file = '/run/tls/server.crt'
ssl_key_file = '/run/tls/server.key'
password_encryption = 'scram-sha-256'
max_connections = 80   # application pools total <= 60 (see docs/11 §6); 20 reserved for ops/recovery
shared_buffers = '256MB'
work_mem = '4MB'
maintenance_work_mem = '64MB'
fsync = on
full_page_writes = on
synchronous_commit = on
wal_level = replica
max_wal_size = '2GB'
min_wal_size = '256MB'
log_min_duration_statement = 1000
log_statement = 'none'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
idle_in_transaction_session_timeout = '30s'
timezone = 'UTC'
# This file does NOT enable WAL archiving: before a real pilot, deliver and test
# a separate pgBackRest config + archive_command and restore drill. Do not
# advertise 5-minute RPO with this starter configuration alone.
