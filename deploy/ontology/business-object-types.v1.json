    {
      "type_name": "CommercialRecord",
      "version": 1,
      "purpose": "Canonical commercial state (order, payment, renewal, refund) derived only from verified signed commercial events (0130); a customer's own words never create or change it.",
      "source_task": "NX-027",
      "definition": {
        "type_name": "CommercialRecord",
        "display_name": "商业记录",
