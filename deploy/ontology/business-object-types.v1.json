            "render_hint": "plain",
            "visibility": "normal",
            "type_descriptor": null
          },
          {
            "property_name": "status_at",
            "value_type": "string",
            "required": true,
            "nullable": false,
            "default_value": null,
            "description": "决定当前状态的事件的业务时间（UTC ISO 8601）",
            "display_name": "",
            "render_hint": "plain",
            "visibility": "normal",
            "type_descriptor": null
