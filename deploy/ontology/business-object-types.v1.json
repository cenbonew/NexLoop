        "version": 1,
        "title_property": "",
        "icon": "",
        "color": "",
        "plural_display_name": "",
        "properties": [
          {
            "property_name": "kind",
            "value_type": "string",
            "required": true,
            "nullable": false,
            "default_value": null,
            "description": "记录种类：order / payment / renewal / refund",
            "display_name": "",
            "render_hint": "plain",
            "visibility": "normal",
            "type_descriptor": null
          },
          {
            "property_name": "external_id",
            "value_type": "string",
            "required": true,
            "nullable": false,
            "default_value": null,
