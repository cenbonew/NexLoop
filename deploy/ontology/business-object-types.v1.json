            "render_hint": "plain",
            "visibility": "normal",
            "type_descriptor": null
          },
          {
            "property_name": "event_count",
            "value_type": "integer",
            "required": true,
            "nullable": false,
            "default_value": null,
            "description": "已核验事件数",
            "display_name": "",
            "render_hint": "plain",
            "visibility": "normal",
            "type_descriptor": null
          },
          {
            "property_name": "late_event_count",
            "value_type": "integer",
            "required": true,
            "nullable": false,
            "default_value": null,
