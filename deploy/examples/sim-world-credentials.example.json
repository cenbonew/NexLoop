{
  "schema": "nexloop-sim-credentials/1",
  "tenant_id": "<TENANT_ID>",
  "world": "sim:00000000-0000-4000-8000-000000000000",
  "uses": [
    "api",
    "worker",
    "agent"
  ],
  "token_dir": "/sim-tokens",
  "signing_key_file": "/setup/<TRUSTED_CONFIGURATION_SIGNING_KEY_FILE>",
  "signing_key_id": "<SIGNING_KEY_ID>",
  "credential_expires_at": "2026-12-31T00:00:00+00:00",
  "check_database_url_file": "/setup/<BOOTSTRAP_READ_ONLY_DSN_FILE: host=/var/run/postgresql ... default_transaction_read_only=on>",
  "bootstrap_database_url_file": "/setup/<BOOTSTRAP_DSN_FILE: user=nexloop_bootstrap host=/var/run/postgresql ... (the issuing run opens its own configurator window)>"
}
