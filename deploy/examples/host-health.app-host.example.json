{
  "schema": "nexloop-host-health/1",
  "host_role": "app_host",
  "recorder_dsn_file": "<HOST_RECORDER_DSN_FILE_0600>",
  "state_file": "/var/lib/nexloop-host-health/state.json",
  "grace_seconds": 5,
  "local_window_seconds": 900,
  "local_min_restarts": 3,
  "containers": [{"name": "api", "container": "<API_CONTAINER_NAME>"}, {"name": "agent-host", "container": "<AGENT_HOST_CONTAINER_NAME>"},
                 {"name": "gateway", "container": "<GATEWAY_CONTAINER_NAME>"},
                 {"name": "runtime-worker", "container": "nexloop-app-runtime-worker-1"}],
  "services": [],
  "timers": [
    {"name": "provider-drift", "timer": "nexloop-provider-drift.timer", "service": "nexloop-provider-drift.service"},
    {"name": "file-backup", "timer": "nexloop-file-backup.timer", "service": "nexloop-file-backup.service"},
    {"name": "file-backup-maint", "timer": "nexloop-file-backup-maint.timer", "service": "nexloop-file-backup-maint.service"}
  ]
}
