{
  "schema_version": "nexloop-workbench-roles/1",
  "manifest_version": 2,
  "decision": "NX-028 D1/D2 (owner 2026-10-10, all as recommended): the owner workbench is its own browser business application; enterprise members are existing browser Humans written by trusted configuration only (no self-registration); a customer principal never holds a workbench grant. A role is a set of Action grants, compiled per member by nexloop_eios.workbench_roles and applied through trusted configuration (0050); the member list is private deployment data and never part of this file. Releasing a contact restriction (ADR-023 §2.4), cancelling a commitment, marking a communication commitment and goals/metrics/budget/pause stay owner-only. Actions marked slice 2/3 are declared by those slices; holding a grant before the Action is published grants nothing. v2: slice 3 Action names as published by L4 (nexloop.conversation.takeover/handback, nexloop.message.staff_send), owner and operator.",
  "roles": {
    "owner": [
      "eios:action:nexloop.workbench.read:1",
      "eios:action:nexloop.contact.read:1",
      "eios:action:nexloop.commitment.read:1",
      "eios:action:Goal.publish:1",
      "eios:action:Goal.propose:1",
      "eios:action:Metric.approve:1",
      "eios:action:Budget.set:1",
      "eios:action:Control.set:1",
      "eios:action:Contact.release:1",
      "eios:action:Commitment.cancel:1",
      "eios:action:Commitment.extend:1",
      "eios:action:Commitment.attest:1",
      "eios:action:Commitment.condition_met:1",
      "eios:action:Commitment.mark_communication:1",
      "eios:action:nexloop.plan.request_reevaluation:1",
      "eios:action:nexloop.service.query_request:1",
      "eios:action:nexloop.conversation.takeover:1",
      "eios:action:nexloop.conversation.handback:1",
      "eios:action:nexloop.message.staff_send:1"
    ],
    "operator": [
      "eios:action:nexloop.workbench.read:1",
      "eios:action:nexloop.contact.read:1",
      "eios:action:nexloop.commitment.read:1",
      "eios:action:Commitment.extend:1",
      "eios:action:Commitment.attest:1",
      "eios:action:Commitment.condition_met:1",
      "eios:action:nexloop.plan.request_reevaluation:1",
      "eios:action:nexloop.service.query_request:1",
      "eios:action:nexloop.conversation.takeover:1",
      "eios:action:nexloop.conversation.handback:1",
      "eios:action:nexloop.message.staff_send:1"
    ],
    "reviewer": [
      "eios:action:ontology.schema.review:1"
    ]
  },
  "slices": {
    "slice_1_reads": ["nexloop.workbench.read", "nexloop.contact.read", "nexloop.commitment.read"],
    "existing_governed": ["Goal.publish", "Goal.propose", "Metric.approve", "Budget.set", "Control.set", "Contact.release", "Commitment.cancel", "Commitment.extend", "Commitment.attest", "Commitment.condition_met", "Commitment.mark_communication", "ontology.schema.review"],
    "slice_2": ["nexloop.plan.request_reevaluation", "nexloop.service.query_request"],
    "slice_3": ["nexloop.conversation.takeover", "nexloop.conversation.handback", "nexloop.message.staff_send"]
  }
}
