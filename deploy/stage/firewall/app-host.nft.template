# NX-032 §3.1–3.2: APP_HOST rules in their own table (undo: nft delete table inet nexloop_stage). Applied by the owner only.
# Gateway only for the trusted LAN; internal ports are never published; the application namespace reaches only DATA_HOST's
# PostgreSQL and Valkey, the Agent Host namespace only the model allowlist (NX-037 D4), the effect worker namespace only PostgreSQL
# and the enterprise endpoint (NX-037 provider routing), the claim workers' namespace only PostgreSQL and the model allowlist
# (G-CLAIM-EGRESS); the CI user (NX-033) never reaches DATA_HOST
# or the internal ports. NX-035 M8: the pgBackRest TLS server (repo1) on the host accepts DATA_HOST only. The reference endpoint
# admits the effect worker network only (run sheet 4.2), and the trusted staff networks for its staff page when STAFF_ALLOW_CIDRS is set.
table inet nexloop_stage {
  chain input {
    type filter hook input priority filter - 1; policy accept;
    ip saddr __DATA_HOST_ADDR__ tcp dport __PGBACKREST_TLS_PORT__ accept
    tcp dport __PGBACKREST_TLS_PORT__ drop
  }
  chain forward {
    type filter hook forward priority filter - 1; policy accept;
    # Replies of admitted connections: the DNAT'ed reply leaves the container with its own source address, so the original-
    # destination drop rules below would otherwise drop it (2026-10-14 first start: APP_HOST -> PostgreSQL SYN-ACKs dropped).
    ct direction reply accept
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst { __GATEWAY_HTTPS_PORT__, __GATEWAY_REDIRECT_PORT__ } ip saddr __TRUSTED_LAN_CIDR__ accept
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst { __GATEWAY_HTTPS_PORT__, __GATEWAY_REDIRECT_PORT__ } drop
    # Owner ruling 2026-10-15 (run sheet 4.2): the reference endpoint (deploy/stage/reference-endpoint, published by DNAT on
    # __APP_HOST_ADDR__) admits the effect worker network only; every other source is dropped. Replies pass by the rule above.
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst __REFERENCE_ENDPOINT_PORT__ ip saddr __EFFECT_EGRESS_CIDR__ accept
    # Calibration 2026-10-17: the staff page (same port, /staff) for the trusted staff networks STAFF_ALLOW_CIDRS only. Optional: the
    # renderer leaves this line out when the parameter is absent or empty, so by default no staff network is admitted.
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst __REFERENCE_ENDPOINT_PORT__ ip saddr { __STAFF_ALLOW_CIDRS__ } accept
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst __REFERENCE_ENDPOINT_PORT__ drop
    # NX-037 D4: two namespaces, two egress rules. The application namespace (API, workers; __APP_CONTAINER_CIDR__) reaches
    # DATA_HOST's PostgreSQL and Valkey only and never a model address; the Agent Host's own namespace (__AGENT_EGRESS_CIDR__)
    # reaches the model provider allowlist on 443 only and never DATA_HOST. The agent link between them is an internal network
    # (no forwarding at all).
    ip saddr __APP_CONTAINER_CIDR__ ip daddr { __MODEL_PROVIDER_ALLOWLIST_ALL__ } drop
    ip saddr __APP_CONTAINER_CIDR__ ip daddr __DATA_HOST_ADDR__ tcp dport { __PG_PORT__, __VALKEY_PORT__ } accept
    ip saddr __APP_CONTAINER_CIDR__ ct state new drop
    # NX-037 provider routing: the effect worker's own namespace (__EFFECT_EGRESS_CIDR__; the action worker and the NexLoop delivery
    # service on its loopback) reaches DATA_HOST's PostgreSQL and the one enterprise endpoint only; never a model address, never
    # Valkey, nothing else.
    ip saddr __EFFECT_EGRESS_CIDR__ ip daddr { __MODEL_PROVIDER_ALLOWLIST_ALL__ } drop
    ip saddr __EFFECT_EGRESS_CIDR__ ip daddr __DATA_HOST_ADDR__ tcp dport __PG_PORT__ accept
    ip saddr __EFFECT_EGRESS_CIDR__ ip daddr __ENTERPRISE_ENDPOINT_ADDR__ tcp dport __ENTERPRISE_ENDPOINT_PORT__ accept
    ip saddr __EFFECT_EGRESS_CIDR__ ct state new drop
    # G-CLAIM-EGRESS: the claim workers' own namespace (__CLAIM_EGRESS_CIDR__; claim-extraction-worker, claim-matcher, the only
    # model credential holders besides the Agent Host, and the recall indexer calling the embedding endpoint) reaches DATA_HOST's
    # PostgreSQL and its own model allowlist (CLAIM_MODEL_PROVIDER_ALLOWLIST, default MODEL_PROVIDER_ALLOWLIST) on 443 only;
    # never Valkey, never another DATA_HOST port, nothing else.
    ip saddr __CLAIM_EGRESS_CIDR__ ip daddr __DATA_HOST_ADDR__ tcp dport __PG_PORT__ accept
    ip saddr __CLAIM_EGRESS_CIDR__ ip daddr { __CLAIM_MODEL_PROVIDER_ALLOWLIST__ } tcp dport 443 accept
    ip saddr __CLAIM_EGRESS_CIDR__ ct state new drop
    ip saddr __AGENT_EGRESS_CIDR__ ip daddr __DATA_HOST_ADDR__ drop
    ip saddr __AGENT_EGRESS_CIDR__ ip daddr { __MODEL_PROVIDER_ALLOWLIST__ } tcp dport 443 accept
    ip saddr __AGENT_EGRESS_CIDR__ ct state new drop
  }
  # NX-033 §3.2 (PR #16 review): the CI rules match the CI account's UID and its whole subordinate UID range (CI_SUBUID_RANGE):
  # rootless containers and any process that enters a user namespace through the setuid newuidmap open sockets as those UIDs, which a
  # rule on the account's UID alone would miss. (A cgroupv2 match is not used: nft resolves the cgroup path when the table loads,
  # at boot before the CI user's slice exists, so the load would fail.)
  chain output {
    type filter hook output priority filter - 1; policy accept;
    meta skuid { __CI_UID__, __CI_SUBUID_RANGE__ } ip daddr __DATA_HOST_ADDR__ drop
    meta skuid { __CI_UID__, __CI_SUBUID_RANGE__ } oifname "lo" tcp dport { __API_INTERNAL_PORT__, __API_INTERNAL_PORT_2__, __HOST_INTERNAL_PORT__, __GUARD_PORT__, __GATEWAY_HTTPS_PORT__ } drop
    meta skuid { __CI_UID__, __CI_SUBUID_RANGE__ } tcp dport __PGBACKREST_TLS_PORT__ drop
    # NX-033 §3.2: the CI account reaches no internal network (the trusted LAN and the management network, one set without
    # duplicates). Its dependency stages reach the public package mirrors directly (plan L); DNS goes through the local resolver
    # stub, whose forwarding is not the CI account's traffic.
    meta skuid { __CI_UID__, __CI_SUBUID_RANGE__ } ip daddr { __CI_DENY_CIDRS__ } drop
  }
}
