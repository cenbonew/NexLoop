# NX-032 §3.1–3.2: APP_HOST rules in their own table (undo: nft delete table inet nexloop_stage). Applied by the owner only.
# Gateway only for the trusted LAN; internal ports are never published; the application namespace reaches only DATA_HOST's
# PostgreSQL and Valkey, the Agent Host namespace only the model allowlist (NX-037 D4); the CI user (NX-033) never reaches DATA_HOST
# or the internal ports.
table inet nexloop_stage {
  chain forward {
    type filter hook forward priority filter - 1; policy accept;
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst { __GATEWAY_HTTPS_PORT__, __GATEWAY_REDIRECT_PORT__ } ip saddr __TRUSTED_LAN_CIDR__ accept
    ct original ip daddr __APP_HOST_ADDR__ ct original proto-dst { __GATEWAY_HTTPS_PORT__, __GATEWAY_REDIRECT_PORT__ } drop
    # NX-037 D4: two namespaces, two egress rules. The application namespace (API, workers; __APP_CONTAINER_CIDR__) reaches
    # DATA_HOST's PostgreSQL and Valkey only and never a model address; the Agent Host's own namespace (__AGENT_EGRESS_CIDR__)
    # reaches the model provider allowlist on 443 only and never DATA_HOST. The agent link between them is an internal network
    # (no forwarding at all).
    ip saddr __APP_CONTAINER_CIDR__ ip daddr { __MODEL_PROVIDER_ALLOWLIST__ } drop
    ip saddr __APP_CONTAINER_CIDR__ ip daddr __DATA_HOST_ADDR__ tcp dport { __PG_PORT__, __VALKEY_PORT__ } accept
    ip saddr __APP_CONTAINER_CIDR__ ct state new drop
    ip saddr __AGENT_EGRESS_CIDR__ ip daddr __DATA_HOST_ADDR__ drop
    ip saddr __AGENT_EGRESS_CIDR__ ip daddr { __MODEL_PROVIDER_ALLOWLIST__ } tcp dport 443 accept
    ip saddr __AGENT_EGRESS_CIDR__ ct state new drop
  }
  chain output {
    type filter hook output priority filter - 1; policy accept;
    meta skuid __CI_UID__ ip daddr __DATA_HOST_ADDR__ drop
    meta skuid __CI_UID__ oifname "lo" tcp dport { __API_INTERNAL_PORT__, __API_INTERNAL_PORT_2__, __HOST_INTERNAL_PORT__, __GUARD_PORT__, __GATEWAY_HTTPS_PORT__ } drop
  }
}
