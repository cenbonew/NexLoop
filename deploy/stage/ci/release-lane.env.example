# Example only (NX-034 release CI on the existing CI lane). The real file is private (0600) and never committed.
# Non-secret settings the stages of scripts/ci/check need on this lane, copied from what the current lane script exports.
# The controller passes a stage only PATH, HOME, LANG, LC_ALL and TMPDIR; everything else the stages need goes here.
# Refused by scripts/ci/lane_policy.py: any name that looks like a secret (TOKEN, PASSWORD, DSN, DATABASE_URL, *_KEY, AUTH, ...)
# and the names the controller sets itself (PATH, HOME, GIT_ALLOW_PROTOCOL, GIT_TERMINAL_PROMPT).
LC_ALL=C.UTF-8
NEXLOOP_TEST_PG_BIN=<PG_BIN_DIR>
