# Private copy only (0600). Placeholders; no real value belongs in the repository.
ENDPOINT_PROJECT=<ENDPOINT_PROJECT_NAME>
# ENDPOINT_IMAGE is not set here: it comes from the release (endpoint.images.env, rendered by deploy.py dry-run).
# Runs on APP_HOST as its own Compose project; bind to the APP_HOST address the effect worker reaches.
ENDPOINT_BIND_ADDR=<APP_HOST_ADDR>
ENDPOINT_PORT=<ENDPOINT_PORT>
# Source tenant label shown on the staff page (one endpoint serves one enterprise).
ENDPOINT_TENANT_LABEL=<ENDPOINT_TENANT_LABEL>
ENDPOINT_SECRETS_DIR=<ABSOLUTE_PRIVATE_SECRETS_DIR>
# Staff entry tickets (S81, stage only): off unless this line is uncommented; entry_ticket_key must exist in the secrets dir either way.
# ENDPOINT_ENTRY_TICKET_KEY_FILE=/run/secrets/entry_ticket_key
