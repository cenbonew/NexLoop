{
 "location": "APP_HOST_CLAIM_EGRESS",
 "targets": {
  "MODEL_ALLOWLISTED_1": {
   "host": "<MODEL_ALLOWLIST_ADDR_1>",
   "port": 443
  },
  "MODEL_ALLOWLISTED_2": {
   "host": "<MODEL_ALLOWLIST_ADDR_2>",
   "port": 443
  },
  "DATA_PG": {
   "host": "<DATA_HOST_ADDR>",
   "port": 55432
  },
  "DATA_VALKEY": {
   "host": "<DATA_HOST_ADDR>",
   "port": 56379
  },
  "DATA_SSH": {
   "host": "<DATA_HOST_ADDR>",
   "port": 22
  },
  "UNLISTED_EXTERNAL": {
   "host": "<UNLISTED_EXTERNAL_ADDR>",
   "port": 443
  },
  "APP_API_ON_HOST": {
   "host": "<APP_HOST_ADDR>",
   "port": 8000
  },
  "APP_API_IN_APP_NET": {
   "host": "<APP_NET_CONTAINER_ADDR>",
   "port": 8000
  }
 },
 "probes": [
  {
   "code": "model_allowlisted_1",
   "kind": "tcp",
   "target": "MODEL_ALLOWLISTED_1",
   "expect": "reachable"
  },
  {
   "code": "model_allowlisted_2",
   "kind": "tcp",
   "target": "MODEL_ALLOWLISTED_2",
   "expect": "reachable"
  },
  {
   "code": "data_pg",
   "kind": "tcp",
   "target": "DATA_PG",
   "expect": "reachable"
  },
  {
   "code": "data_valkey",
   "kind": "tcp",
   "target": "DATA_VALKEY",
   "expect": "unreachable"
  },
  {
   "code": "data_ssh",
   "kind": "tcp",
   "target": "DATA_SSH",
   "expect": "unreachable"
  },
  {
   "code": "unlisted_external",
   "kind": "tcp",
   "target": "UNLISTED_EXTERNAL",
   "expect": "unreachable",
   "note": "Positive control (run sheet 4.2 §7): the same address and port must be reachable from APP_HOST itself, so that unreachable here can only come from the claim_egress rule."
  },
  {
   "code": "api_on_host",
   "kind": "tcp",
   "target": "APP_API_ON_HOST",
   "expect": "unreachable"
  },
  {
   "code": "api_in_app_net",
   "kind": "tcp",
   "target": "APP_API_IN_APP_NET",
   "expect": "unreachable"
  }
 ]
}
