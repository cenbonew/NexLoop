# EIOS gap E2/E3 (docs/implementation/host-health.md): the host health probe, on APP_HOST and DATA_HOST. Example only: copy to
# /etc/systemd/system/ without the .example suffix, then `systemctl daemon-reload` and `systemctl enable --now
# nexloop-host-health.timer` (B class, owner confirms).
# It runs as root because it reads `docker inspect` and `systemctl show` of other units; it runs only those two fixed read-only
# commands (no shell) and writes only through this host's recorder DSN (role nexloop_host_recorder_<host role>: one function, no
# table; the database derives the host from the role). The runtime
# services get nothing of it. The configuration and the DSN file are 0600 root (paths in /etc/nexloop; no secret in this unit).
# Installed by scripts/deploy/host_health_install.sh: /opt/nexloop/host-health/<release sha> (probe + a psycopg-only venv, root-owned), `current` points at it.
[Unit]
Description=NexLoop host health probe (crash loops, scheduled-run freshness)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/nexloop/host-health/current/venv/bin/python -I -B /opt/nexloop/host-health/current/host_health_probe.py --config /etc/nexloop/host-health.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=60
StateDirectory=nexloop-host-health
StateDirectoryMode=0700
# ProtectHome=true makes /root unreadable; libpq looks for ~/.postgresql/postgresql.crt on the hostssl path (APP_HOST) and takes
# that EACCES as an error. HOME is the state directory (stage 2026-10-25).
Environment=HOME=/var/lib/nexloop-host-health
StandardError=journal
CapabilityBoundingSet=
ProtectKernelModules=true
PrivateDevices=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
# W^X stays on by default. Only a host whose venv is a standalone CPython (APP_HOST's /opt/nexloop/python-3.12, which dies with
# SIGSEGV under it - stage 2026-10-25) turns it off, explicitly: memory_deny_write_execute=false in the install configuration
# makes the installer write nexloop-host-health.service.d/50-installer-mdwe.conf with MemoryDenyWriteExecute=no.
LockPersonality=true
# Local findings (crash loop, blindness, a failed recording) are journal lines of priority err: watch them with
# `journalctl -p err -u nexloop-host-health` from outside PostgreSQL (the database may be what loops).
# /opt/nexloop/release and the virtual environment must be writable by root only (this unit runs them as root).
