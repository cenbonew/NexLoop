# NX-054 P4a (docs/design/relation-read-p4.md §2.5): the daily relation read gap check on DATA_HOST. Installed by
# scripts/deploy/relation_gaps_install.sh (one private configuration, one command, root), which fills the @...@ tokens; do not copy it
# by hand. As the metrics login over the host's socket (/etc/nexloop/relation-gaps/metrics.dsn, 0600, the unit's user), in a
# read-only transaction; counts only. The answer goes to the evidence directory, one file per UTC day (kept 30 days). Gaps (exit 1)
# or unwritten evidence (exit 2) fail the unit: host-health records the failed scheduled run and timer_scheduled_failure fires (alert
# rules v18+); a timer that stops running is timer_stale_relation_read_gaps (v19). The <3> stderr line is for `journalctl -p err`
# only, nothing forwards it.
[Unit]
Description=NexLoop relation read gap check (read only)
After=network-online.target

[Service]
Type=oneshot
User=nexloop-relation-gaps
Group=nexloop-relation-gaps
ExecStart=@PYTHON@ -I -B /opt/nexloop/relation-gaps/current/scripts/acceptance/relation_read_gaps.py --dsn-file /etc/nexloop/relation-gaps/metrics.dsn --tenant @TENANT_ID@ --evidence-dir @EVIDENCE_DIR@
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
LockPersonality=true
UMask=0027
ReadWritePaths=@EVIDENCE_DIR@
