# NX-035 (deploy runbook step 5.1): DATA_HOST backup unit. Example only: copy to /etc/systemd/system/ without the
# .example suffix, then `systemctl daemon-reload` and `systemctl enable --now <timer>` (B class, owner confirms).
# User nexloop-backup owns the file repository and secrets/backup and is in the docker group only to reach the PG container
# (pgBackRest runs inside the nexloop/postgres image). The executors come from the backup-only Python virtual environment
# installed from the release commit (M13/M14). Every private value is a path in EnvironmentFile (0600, root:nexloop-backup);
# no secret is written in this unit. RequiresMountsFor lists the LUKS mount points of NX-035 step 1 (example paths: keep them
# equal to the private env), so the unit never starts on an unmounted, unencrypted directory.
# /etc/nexloop/restic.env (0600) holds the paths RESTIC_REPO1_/RESTIC_REPO2_REPOSITORY_FILE and _PASSWORD_FILE and repo2's
# AWS_* keys, and optionally RESTIC_REPO2_OPTIONS="-o s3.bucket-lookup=dns" (repo2 on TOS; unset or empty adds nothing). Retention as D4 (14 days, one monthly, at most 35 days); `check` daily, `check --read-data-subset 1/10` weekly.
# Retention per tag (--group-by host,tags; L7 2026-10-26): repo1 holds the restore journal (tag journal, one fixed path) and the APP_HOST
# file snapshots (tags files_artifact / files_runtime, each from a new staging directory). restic's default grouping is host,paths,
# under which every file snapshot is a group of one and is never forgotten; grouped by tag, each kind keeps D4's window of its own
# snapshots. --retry-lock 10m (L6 S2): prune takes the exclusive lock; a file backup or journal backup holding its shared lock then
# makes the daily run wait for it instead of failing. Applied to an installed copy by scripts/deploy/restic_maint_data_host.sh
# (owner, root, confirmed by the owner in person). Before each forget a guard line (restic_future_guard.py, L6 F1) refuses to go on
# while a snapshot is dated more than an hour ahead: keep-within counts from a group's newest snapshot, so a future-dated one would make
# forget delete every real snapshot of its group.
[Unit]
Description=NexLoop restic retention and checks (daily; deep check on Sundays)
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/srv/nexloop/secrets /srv/nexloop-backup/files

[Service]
Type=oneshot
User=nexloop-backup
Group=nexloop-backup
EnvironmentFile=/etc/nexloop/restic.env
ExecStart=/usr/bin/python3 -I -B /opt/nexloop/restic-maint/restic_future_guard.py --max-ahead-seconds 3600 -- /usr/local/bin/restic --no-cache --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE}
ExecStart=/usr/local/bin/restic --no-cache --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE} forget --retry-lock 10m --group-by host,tags --keep-within 14d --keep-monthly 1 --prune
ExecStart=/usr/local/bin/restic --no-cache --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE} check
ExecStart=/bin/sh -c 'if [ "$$(date +%%u)" = 7 ]; then exec /usr/local/bin/restic --no-cache --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE} check --read-data-subset 1/10; fi'
ExecStart=/usr/bin/python3 -I -B /opt/nexloop/restic-maint/restic_future_guard.py --max-ahead-seconds 3600 -- /usr/local/bin/restic --no-cache $RESTIC_REPO2_OPTIONS --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE}
ExecStart=/usr/local/bin/restic --no-cache $RESTIC_REPO2_OPTIONS --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE} forget --retry-lock 10m --group-by host,tags --keep-within 14d --keep-monthly 1 --prune
ExecStart=/usr/local/bin/restic --no-cache $RESTIC_REPO2_OPTIONS --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE} check
ExecStart=/bin/sh -c 'if [ "$$(date +%%u)" = 7 ]; then exec /usr/local/bin/restic --no-cache ${RESTIC_REPO2_OPTIONS} --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE} check --read-data-subset 1/10; fi'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ProtectSystem=strict: only the encrypted file repository volume (journal segments, restic repo1) is writable.
ReadWritePaths=/srv/nexloop-backup/files
UMask=0077
