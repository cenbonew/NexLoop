# NX-035 (deploy runbook step 5.1): DATA_HOST backup unit. Example only: copy to /etc/systemd/system/ without the
# .example suffix, then `systemctl daemon-reload` and `systemctl enable --now <timer>` (B class, owner confirms).
# User nexloop-backup owns the file repository and secrets/backup and is in the docker group only to reach the PG container
# (pgBackRest runs inside the nexloop/postgres image). The executors come from the backup-only Python virtual environment
# installed from the release commit (M13/M14). Every private value is a path in EnvironmentFile (0600, root:nexloop-backup);
# no secret is written in this unit. RequiresMountsFor lists the LUKS mount points of NX-035 step 1 (example paths: keep them
# equal to the private env), so the unit never starts on an unmounted, unencrypted directory.
# Writes one pending and one verified/failed manifest row per repo (NX-035-pgbackrest.md); repo1 is the APP_HOST TLS server.
[Unit]
Description=NexLoop weekly full PG backup (pgBackRest, repo1 then repo2)
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/srv/nexloop/secrets

[Service]
Type=oneshot
User=nexloop-backup
Group=nexloop-backup
EnvironmentFile=/etc/nexloop/backup.env
ExecStart=/opt/nexloop/backup-venv/bin/nexloop-backup pg --recorder-dsn-file ${BACKUP_SECRETS}/recorder_dsn --pgbackrest-command-file ${BACKUP_SECRETS}/pgbackrest-command.json --stanza nexloop --expected-version ${PGBACKREST_VERSION} --repo repo1 --kind pg_full
ExecStart=/opt/nexloop/backup-venv/bin/nexloop-backup pg --recorder-dsn-file ${BACKUP_SECRETS}/recorder_dsn --pgbackrest-command-file ${BACKUP_SECRETS}/pgbackrest-command.json --stanza nexloop --expected-version ${PGBACKREST_VERSION} --repo repo2 --kind pg_full
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
