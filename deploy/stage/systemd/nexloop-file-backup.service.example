# NX-035 slice 3 (deploy runbook step 5.1; docs/implementation/NX-035-file-backup.md §6): the APP_HOST file backup - the Artifacts
# and the finished Run stores of world real into restic, repo1 (DATA_HOST over the restricted sftp account, the repository the
# restore journal uses) then repo2 (S3). Owner 2026-10-26 (D1-D6, all as recommended): enabled now (no longer the M12 "not enabled"
# of the deploy days). Installed by scripts/deploy/file_backup_install.sh (one private configuration, one command, root), which
# fills the @...@ tokens and writes /etc/nexloop/file-backup.env; do not copy it by hand. The repo2 files named in that env file come
# from scripts/deploy/install_repo2_secrets.sh files (it also sets FILE_BACKUP_REPO2_OPTIONS, "--s3-bucket-lookup dns" when TOS
# refuses restic's path-style requests; $VAR without braces: systemd drops an empty one).
# D3: the only privilege is CAP_DAC_READ_SEARCH (read past the 0700/0600 modes the API and the Agent Host keep; never write), and the
# sandbox shows nothing of /srv/nexloop but the two data directories and this unit's own secrets/backup (read-only); the installer's
# step 5 checks that from inside this very sandbox before the timer is enabled. Each run prints one JSON line of counts, labels and
# hashes, never a secret.
[Unit]
Description=NexLoop file backup (Artifacts and finished Run stores, repo1 then repo2)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/nexloop/secrets

[Service]
Type=oneshot
User=nexloop-file-backup
Group=nexloop-file-backup
EnvironmentFile=/etc/nexloop/file-backup.env
ExecStart=@PYTHON@ -I -B /opt/nexloop/file-backup/current/scripts/deploy/file_backup_run.py --kind artifact --recorder-dsn-file ${BACKUP_SECRETS}/recorder.dsn --source-root /srv/nexloop/data/artifacts --staging-root ${FILE_BACKUP_STAGING} --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE} --repo repo1 --key-ref ${FILE_BACKUP_KEY_REF} --restic @RESTIC@
ExecStart=@PYTHON@ -I -B /opt/nexloop/file-backup/current/scripts/deploy/file_backup_run.py --kind artifact --recorder-dsn-file ${BACKUP_SECRETS}/recorder.dsn --source-root /srv/nexloop/data/artifacts --staging-root ${FILE_BACKUP_STAGING} --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE} --repo repo2 --key-ref ${FILE_BACKUP_KEY_REF} --restic @RESTIC@ --environment-file ${OFFSITE_ENVIRONMENT_FILE} $FILE_BACKUP_REPO2_OPTIONS
ExecStart=@PYTHON@ -I -B /opt/nexloop/file-backup/current/scripts/deploy/file_backup_run.py --kind runtime --recorder-dsn-file ${BACKUP_SECRETS}/recorder.dsn --source-root /srv/nexloop/data/runtime --staging-root ${FILE_BACKUP_STAGING} --repository-file ${RESTIC_REPO1_REPOSITORY_FILE} --password-file ${RESTIC_REPO1_PASSWORD_FILE} --repo repo1 --key-ref ${FILE_BACKUP_KEY_REF} --restic @RESTIC@
ExecStart=@PYTHON@ -I -B /opt/nexloop/file-backup/current/scripts/deploy/file_backup_run.py --kind runtime --recorder-dsn-file ${BACKUP_SECRETS}/recorder.dsn --source-root /srv/nexloop/data/runtime --staging-root ${FILE_BACKUP_STAGING} --repository-file ${RESTIC_REPO2_REPOSITORY_FILE} --password-file ${RESTIC_REPO2_PASSWORD_FILE} --repo repo2 --key-ref ${FILE_BACKUP_KEY_REF} --restic @RESTIC@ --environment-file ${OFFSITE_ENVIRONMENT_FILE} $FILE_BACKUP_REPO2_OPTIONS
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=@MDWE@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=/srv/nexloop:ro
BindReadOnlyPaths=/srv/nexloop/data/artifacts /srv/nexloop/data/runtime /srv/nexloop/secrets/backup
InaccessiblePaths=/etc/nexloop -/etc/pgbackrest -/etc/ssl/private -/var/log -/var/lib/nexloop -/srv/nexloop-backup -/var/lib/docker -/var/lib/containerd -/var/lib/nexloop-host-health -/etc/shadow -/etc/gshadow -/etc/ssh/ssh_host_ed25519_key -/etc/ssh/ssh_host_ecdsa_key -/etc/ssh/ssh_host_rsa_key
ReadWritePaths=/var/lib/nexloop-file-backup/staging
UMask=0077
