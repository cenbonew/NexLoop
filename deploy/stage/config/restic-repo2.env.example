# NX-035 repo2 on Volcengine TOS: /etc/nexloop/restic-repo2.env on DATA_HOST (journal, nexloop-journal-restic@repo2) and the
# repo2 lines of /etc/nexloop/restic.env (nexloop-restic-maint), 0600 root:nexloop-backup. Example only; __X__ by the owner.
# The repository location and its password are files restic reads itself (never on a command line):
#   repository file: s3:https://tos-s3-__TOS_REGION__.volces.com/__TOS_BUCKET__/nexloop/restic-journal
# The same journal directory as /etc/nexloop/restic-repo1.env.
JOURNAL_DIR=__SAME_AS_RESTIC_REPO1_JOURNAL_DIR__
RESTIC_REPOSITORY_FILE=/srv/nexloop/secrets/backup/restic-repo2.repository
RESTIC_PASSWORD_FILE=/srv/nexloop/secrets/backup/restic-repo2.pass
# The DATA_HOST backup sub-user (the same as pgBackRest repo2); restic's S3 backend reads these from its environment.
AWS_ACCESS_KEY_ID=__TOS_DATA_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__TOS_DATA_SECRET_ACCESS_KEY__
AWS_DEFAULT_REGION=__TOS_REGION__
