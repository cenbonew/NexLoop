# NX-035 repo2 on Volcengine TOS: the --environment-file of nexloop-file-backup --repo repo2 on APP_HOST (0600, owned by the
# nexloop-file-backup user). Only these three keys are accepted (nexloop_eios.file_backup._ENVIRONMENT_KEYS); the repository
# file of repo2 holds s3:https://tos-s3-__TOS_REGION__.volces.com/__TOS_BUCKET__/nexloop/restic-files
# The APP_HOST backup sub-user: its own key pair, scoped to nexloop/restic-files/ only.
AWS_ACCESS_KEY_ID=__TOS_APP_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__TOS_APP_SECRET_ACCESS_KEY__
AWS_DEFAULT_REGION=__TOS_REGION__
