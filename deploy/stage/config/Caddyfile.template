# NX-032 §2.1, §3.1 (D8): the Gateway, only for the trusted LAN (enforced by the firewall), HTTP only redirects. It runs in the
# application namespace of compose.app.example.yaml and proxies to the API on loopback; the API serves the built web root.
# Server TLS only (D2) with the gateway certificate from the internal CA; LAN users install the root certificate.
# S59: the root file system is read-only and nothing persists. persist_config off: no autosave to /config (with admin off nothing
# else writes there). /data is a small tmpfs (compose): auto_https off and the certificates come from secrets, so no certificate or
# ACME state is kept; Caddy only writes its storage locks there, and they may be lost on restart.
{
    auto_https off
    admin off
    persist_config off
}
http://__APP_HOST_NAME__:8080 {
    redir https://__APP_HOST_NAME__:__GATEWAY_HTTPS_PORT__{uri} permanent
}
https://__APP_HOST_NAME__:8443 {
    tls /run/secrets/gateway_cert /run/secrets/gateway_key {
        protocols tls1.3
    }
    encode gzip
    handle /internal/* {
        respond "Not found" 404
    }
    handle {
        reverse_proxy https://127.0.0.1:__API_INTERNAL_PORT__ https://127.0.0.1:__API_INTERNAL_PORT_2__ {
            transport http {
                tls_trusted_ca_certs /run/secrets/api_loopback_ca
                tls_server_name 127.0.0.1
            }
            # Caddy sets Host to the upstream address for an HTTPS upstream; the API's browser routes require the public
            # origin's host:port (browser_http.py session check), so the original Host is passed on (2026-10-15 first start: 403).
            header_up Host {http.request.hostport}
            header_up -X-Forwarded-For
            # L6 C11: the login rate limit's client address. Overwritten with the TLS peer (a client's own header of this name is
            # replaced, never passed on); the API trusts it only from this gateway on loopback (--trusted-proxy-peer 127.0.0.1).
            header_up X-NexLoop-Client-IP {remote_host}
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}
# Forwarded client addresses are not trusted (the API derives identity from its own session): the one exception is the login rate
# limit's X-NexLoop-Client-IP, which this gateway always overwrites and the API trusts from loopback only. /internal is never reachable.
