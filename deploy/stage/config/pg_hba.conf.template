# NX-032 §2.2 (D2): rendered by scripts/deploy/render.py from the private env of DATA_HOST; no placeholder may remain.
# The bootstrap identity only over the container-local socket (bootstrap, health), with its SCRAM password (the image's
# initialisation connects as it with POSTGRES_PASSWORD_FILE); never over the network.
local   all            nexloop_bootstrap                                   scram-sha-256
# NX-035 (design §4.1): the backup roles only over the container-local socket (pgBackRest in the container, the backup
# executor on DATA_HOST through the mounted socket directory), with their SCRAM passwords; never over the network.
local   all            nexloop_backup                                      scram-sha-256
local   all            nexloop_backup_recorder                             scram-sha-256
# NX-032 §3b: the configurator only over the container-local socket, only while `stage_secrets.py register --bootstrap-dsn-file`
# holds its login window (the role is NOLOGIN without a password otherwise, so this line admits nobody).
local   all            nexloop_configurator                                scram-sha-256
# Evolution (NX-038/NX-039, stage enrollment 2026-10-21): the three evolution login roles over the container-local socket only, in
# the stage catalog only, with their SCRAM passwords (set in the bootstrap window; without one the line admits nobody). The
# enrollment tool and the S6 acceptance run in one-off DATA_HOST containers on the mounted socket directory, like the migration;
# no network entry (no hostssl line), so APP_HOST and every other address stay refused below.
local   __NEXLOOP_DB__ nexloop_evo_reader,nexloop_evo_writer,nexloop_evo_evaluator scram-sha-256
# G-METRICS-DSN: the read-only metrics role (execute on the export, readiness and backup status functions only, 0131/0151/0161).
# From APP_HOST (deploy gate, real_tenant_init verify) with its client certificate alone (CN nexloop_metrics, no password); this
# line precedes the application line below, so the first match is certificate authentication. On DATA_HOST, `nexloop-doctor
# --backup` (the backup executor's account) reaches it over the host-local socket directory with its SCRAM password, like the
# backup recorder.
hostssl __NEXLOOP_DB__ nexloop_metrics __APP_HOST_ADDR__/32 cert
local   all            nexloop_metrics                                     scram-sha-256
# Every application role from APP_HOST only: TLS, SCRAM and a client certificate whose CN is the role (clientcert=verify-full).
hostssl __NEXLOOP_DB__ __APP_PG_ROLES__ __APP_HOST_ADDR__/32 scram-sha-256 clientcert=verify-full
# NX-041 S6/S6c (simulation process group, stage enablement 2026-10-21): the simulation login roles, from APP_HOST only (the group's
# containers leave APP_HOST masqueraded like every container namespace there), TLS, SCRAM, the stage catalog alone; no client
# certificate. Which APP_HOST source may open these connections is the host's nexloop_simulation table
# (docs/implementation/NX-041-S6-simulation.nft.example): only NEXLOOP_SIM_SUBNET, and only to this PostgreSQL port. No real role is
# on this line; no simulation role is on the application line above. nexloop_twin_port (0266, seventh batch; no password, so no login)
# joins this line with the eighth batch's twin port and its DSN, not before. Passwords are set in the bootstrap window; without one the line admits nobody.
hostssl __NEXLOOP_DB__ nexloop_sim_worker,nexloop_sim_guard,nexloop_sim_api,nexloop_stand_in_worker,nexloop_sim_files __APP_HOST_ADDR__/32 scram-sha-256
# Migration window only (§8 step 7): uncomment for the window, reload, and comment again afterwards.
#hostssl __NEXLOOP_DB__ __MIGRATION_PG_ROLE__ __MGMT_SOURCE_CIDR__ scram-sha-256 clientcert=verify-full
# Everything else is refused, plaintext first.
hostnossl all          all             0.0.0.0/0                           reject
hostnossl all          all             ::/0                                reject
host      all          all             0.0.0.0/0                           reject
host      all          all             ::/0                                reject
