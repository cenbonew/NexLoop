APP_CONTAINER_CIDR=198.51.100.128/25
AGENT_EGRESS_CIDR=203.0.113.128/25
PG_PORT=55432
VALKEY_PORT=56379
GATEWAY_HTTPS_PORT=8443
GATEWAY_REDIRECT_PORT=8080
API_INTERNAL_PORT=8000
API_INTERNAL_PORT_2=8001
HOST_INTERNAL_PORT=8100
